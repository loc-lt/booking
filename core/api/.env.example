# Booking core API: local configuration. Copy to `.env` (python scripts/dev.py up does it).
#
# Who reads this file:
#   - Django, when you run manage.py / pytest / runserver on your machine (app/settings/__init__.py)
#   - Docker Compose, through `--env-file` set by scripts/dev.py (infra/compose.yaml uses ${VAR:-default})
# Values already in your shell environment win over this file. No variable interpolation, so a
# `$` is a plain character here.
#
# Everything below is a LOCAL default. Servers get their own .env (docs/operations.md, "Secrets").

# ---- Django -----------------------------------------------------------------------------------
# Native runs use the local settings (DEBUG on, dev tokens allowed). Containers always run with
# app.settings.production; Compose sets that itself.
DJANGO_SETTINGS_MODULE=app.settings.local
DJANGO_SECRET_KEY=local-only-not-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
LOG_LEVEL=INFO

# ---- Database ---------------------------------------------------------------------------------
# The Postgres container publishes 55433 on your machine (POSTGRES_HOST_PORT). Inside Compose the
# API uses host `postgres:5432`; that value is fixed in infra/compose.yaml, not read from here.
DATABASE_URL=postgresql://booking_app:booking_app@localhost:55433/booking_core
POSTGRES_HOST_PORT=55433

# ---- Tokens (kernel/auth.py, modules/identity) --------------------------------------------------
# HS256 secret that signs and verifies every JWT the core issues. 32+ bytes. Change it on servers.
# Set JWT_JWKS_URL instead to verify tokens of an external identity provider.
JWT_SECRET=local-only-jwt-secret-change-me-32bytes
JWT_ISSUER=https://auth.local
JWT_AUDIENCE=booking-core
JWT_JWKS_URL=

# ---- Sign-in (D-003) ----------------------------------------------------------------------------
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_GUEST_TTL_SECONDS=7200
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
# Requests per client address on /auth/* (DRF throttle syntax).
AUTH_RATE=30/min
# Where emailed links point: the member app's accept-invitation and reset-password pages.
AUTH_APP_URL=http://localhost:5174

# ---- Email -------------------------------------------------------------------------------------
# Locally emails are printed to the log (`python scripts/dev.py logs worker`). On a server use
# django.core.mail.backends.smtp.EmailBackend and fill the EMAIL_HOST_* values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Booking Core <no-reply@localhost>

# ---- Payments (modules/payments) ----------------------------------------------------------------
# The mock gateway signs webhooks with HMAC-SHA256 of the body using this secret (X-Signature).
# docs/postman/setup_env.py uses the same value for the local scenario.
PAYMENT_WEBHOOK_SECRET=local-only-webhook-secret

# ---- Worker ------------------------------------------------------------------------------------
WORKER_POLL_SECONDS=1
WORKER_BATCH_SIZE=100
WORKER_MAX_ATTEMPTS=10

# ---- Local development only ----------------------------------------------------------------------
# Vite dev servers of the member (5174) and console (5173) apps call the API from another origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Browsable docs at http://localhost:8000/api/docs. Off on servers.
API_DOCS_ENABLED=true
